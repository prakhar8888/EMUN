generator client {
  provider = "prisma-client-js"
  output   = "../../backend/node_modules/@prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  SECRETARIAT
  DELEGATE
}

enum StaffStatus {
  PENDING
  ACTIVE
  REVOKED
}

enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum FeedbackStatus {
  PENDING
  REVIEWED
}

model User {
  id         Int      @id @default(autoincrement())
  fullName   String
  email      String   @unique
  password   String
  phone      String?
  university String?
  country    String?
  role       UserRole @default(DELEGATE)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  staffStatus  StaffStatus @default(ACTIVE)
  designation  String?

  canManageEvents        Boolean @default(false)
  canManageRegistrations Boolean @default(false)
  canManageCommittees    Boolean @default(false)
  canManageFeedback      Boolean @default(false)
  canManageContact       Boolean @default(false)
  canCreateStaff         Boolean @default(false)

  // ======================================
  // PASSWORD RESET (Email OTP)
  // ======================================
  // resetOtp stores a HASHED 6-digit code, never the raw code itself -
  // matching how passwords are stored, so the database never holds a
  // usable secret in plain text. resetOtpExpiry enforces a short
  // validity window (10 minutes), a standard industry default for
  // password-reset OTP flows.
  resetOtp       String?
  resetOtpExpiry DateTime?

  registrations Registration[]

  @@index([email])
}

model FoundationMember {
  id          Int      @id @default(autoincrement())
  fullName    String
  role        String
  imageUrl    String
  bio         String?
  email       String?
  linkedinUrl String?
  websiteUrl  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Event {
  id          Int      @id @default(autoincrement())
  title       String
  slug        String   @unique
  description String
  location    String

  highlight   String?

  startDate   DateTime
  endDate     DateTime

  bannerUrl   String?
  isPublished Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([slug])
  @@index([startDate])
}

model Chamber {
  id                 Int      @id @default(autoincrement())
  name               String
  slug               String   @unique
  agenda             String
  description        String

  iconUrl            String?
  backgroundGuideUrl String?

  isPublished        Boolean  @default(true)

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  registrations      Registration[]

  @@index([slug])
}

model Registration {
  id         Int                @id @default(autoincrement())

  userId     Int
  chamberId  Int

  portfolio  String?
  experience String?
  motivation String?

  status     RegistrationStatus @default(PENDING)

  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  chamber    Chamber @relation(fields: [chamberId], references: [id], onDelete: Cascade)

  @@unique([userId, chamberId])
  @@index([status])
}

model About {
  id        Int      @id @default(autoincrement())
  title     String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Contact {
  id          Int      @id @default(autoincrement())
  name        String
  email       String
  phone       String?
  designation String
  subject     String?
  message     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([email])
}

model Feedback {
  id        Int            @id @default(autoincrement())
  fullName  String?
  email     String?
  rating    Int?
  message   String
  status    FeedbackStatus @default(PENDING)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([email])
}
