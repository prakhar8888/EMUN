{
  "name": "backend",
  "version": "1.0.0",
  "description": "MUNSphere Backend API",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "db:test": "node src/testConnection.js",
    "generate": "prisma generate --schema=../database/prisma/schema.prisma",
